# Export these variables before running the Phase 2 example.
# Use an existing trained multilingual Sentence Transformers model directory.
EMBEDDING_MODEL=
# Preferred local model directory for Phase 3.5; takes precedence over EMBEDDING_MODEL.
EMBEDDING_MODEL_PATH=
EMBEDDING_REVISION=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# Set prefixes according to the chosen model card, e.g. query: / passage: for E5.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
QDRANT_COLLECTION=maintenance_v1
QDRANT_PATH=knowledge/vector_store
